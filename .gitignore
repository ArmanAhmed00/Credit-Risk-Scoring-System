# Virtual environment
.venv/

# Python bytecode
__pycache__/

# Regenerable pipeline output (rebuild: python scripts/data_cleaning.py)
data/processed/*.csv
data/*.csv

# Prediction logs - contain applicant PII (income, age, employment history)
data/processed/*.jsonl

# MLflow local tracking store (only written when MLFLOW_TRACKING_URI is local)
mlruns/
mlflow.db

# Drift reports - ~4.5MB of HTML per run
monitoring/reports/

# Airflow task logs (bind-mounted by docker-compose)
airflow/logs/

# MLflow artifacts + registry DB (bind-mounted by docker-compose)
mlflow/

# Test/coverage artifacts
.coverage
coverage.xml
.pytest_cache/

# Secrets
.env

# macOS
.DS_Store

