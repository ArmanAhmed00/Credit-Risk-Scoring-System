# ---------------------------------------------------------------------------
# Copy to .env and fill in real values:   cp .env.example .env
#
# NEVER commit .env - it holds live credentials. It is already gitignored.
# Every value below is a placeholder; change them all before deploying.
# ---------------------------------------------------------------------------

# --- PostgreSQL -------------------------------------------------------------
# Backs Airflow's metadata DB and receives the processed_features table.
POSTGRES_USER=credit_risk
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=credit_risk
POSTGRES_PORT=5432
# Table written by the save_to_postgres task (if_exists=replace).
PG_FEATURES_TABLE=processed_features

# --- Airflow ----------------------------------------------------------------
AIRFLOW_PORT=8080
# Web UI login created on first start.
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME_admin_password
AIRFLOW_ADMIN_EMAIL=admin@example.com
# Signs session cookies. Generate: python -c "import secrets;print(secrets.token_hex(32))"
AIRFLOW_SECRET_KEY=CHANGE_ME_generate_a_random_64_char_hex_string
# Host UID owning ./airflow, ./data, ./mlflow. On Linux set to `id -u`,
# otherwise mounted files end up root-owned. Leave 50000 on Docker Desktop.
AIRFLOW_UID=50000

# --- MLflow -----------------------------------------------------------------
MLFLOW_PORT=5000
MODEL_NAME=CreditRiskModel

# --- FastAPI inference ------------------------------------------------------
API_PORT=8000
# Stage-based URI. Model registry stages are deprecated in MLflow >=2.9;
# for an alias use models:/CreditRiskModel@production instead.
MODEL_URI=models:/CreditRiskModel/Production

# --- Streamlit UI ----------------------------------------------------------
UI_PORT=8501

# --- Drift monitoring -------------------------------------------------------
# Retraining is triggered when the drifted-column share exceeds this.
DRIFT_SHARE_THRESHOLD=0.3
DRIFT_LOOKBACK_DAYS=7
DRIFT_MIN_ROWS=100
